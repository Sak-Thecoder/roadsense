ROADSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROADSENSE_ENABLED_MODELS=mobilenetv2,resnet50,efficientnetb0
ROADSENSE_MODEL_CACHE=1
ROADSENSE_MAX_UPLOAD_BYTES=8388608
ROADSENSE_MAX_IMAGE_PIXELS=24000000
